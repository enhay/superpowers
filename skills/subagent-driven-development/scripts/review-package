#!/usr/bin/env bash
# Generate a review package: commit list, stat summary, and the net
# diff with extended context, written to a file the reviewer reads in one
# call. Using the recorded per-task BASE (not HEAD~1) keeps multi-commit
# tasks intact.
#
# Usage: review-package [-C REPO] BASE HEAD [OUTFILE]
#   -C REPO diffs that repository instead of the current one. A task spanning
#   repositories gets one package per repo, all written into the one workspace
#   named by SDD_HOME; the file name carries the repo so they cannot collide.
# Default OUTFILE: <workspace>/review-<repo>-<base7>..<head7>.diff
# (named per repo and range, so a re-review after fixes gets a fresh file).
set -euo pipefail

repo=.
if [ "${1-}" = "-C" ]; then
  [ $# -ge 3 ] || { echo "usage: review-package [-C REPO] BASE HEAD [OUTFILE]" >&2; exit 2; }
  repo=$2
  shift 2
fi

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: review-package [-C REPO] BASE HEAD [OUTFILE]" >&2
  exit 2
fi

base=$1
head=$2

git -C "$repo" rev-parse --show-toplevel >/dev/null 2>&1 || { echo "not a repository: $repo" >&2; exit 2; }
# `--verify <40-hex>` accepts a syntactically valid object name that this
# repository does not contain — which is exactly what passing another repo's
# BASE looks like. `^{commit}` forces the object to exist and to be a commit.
name=$(basename "$(git -C "$repo" rev-parse --show-toplevel)")

git -C "$repo" rev-parse --verify --quiet "${base}^{commit}" >/dev/null \
  || { echo "BASE not a commit in $(cd "$repo" && pwd): $base" >&2; exit 2; }
git -C "$repo" rev-parse --verify --quiet "${head}^{commit}" >/dev/null \
  || { echo "HEAD not a commit in $(cd "$repo" && pwd): $head" >&2; exit 2; }
git -C "$repo" merge-base --is-ancestor "$base" "$head" 2>/dev/null \
  || echo "review-package: WARNING — BASE is not an ancestor of HEAD in ${name}; the package will not be a task range" >&2

if [ $# -eq 3 ]; then
  out=$3
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace")
  if [ "$(cd "$(git -C "$repo" rev-parse --show-toplevel)" && pwd)" != "$(cd "$dir/../.." && pwd)" ] \
     && [ -z "${SDD_HOME-}" ]; then
    echo "review-package: WARNING — diffing ${name} but writing into $(cd "$dir/../.." && basename "$(pwd)")." >&2
    echo "  Set SDD_HOME to the task's primary repository so briefs, reports, packages" >&2
    echo "  and the ledger all land in one place." >&2
  fi
  out="$dir/review-${name}-$(git -C "$repo" rev-parse --short "$base")..$(git -C "$repo" rev-parse --short "$head").diff"
fi

{
  echo "# Review package: ${name} ${base}..${head}"
  echo
  echo "## Commits"
  git -C "$repo" log --oneline "${base}..${head}"
  echo
  echo "## Files changed"
  git -C "$repo" diff --stat "${base}..${head}"
  echo
  echo "## Diff"
  git -C "$repo" diff -U10 "${base}..${head}"
} > "$out.partial"
mv "$out.partial" "$out"

commits=$(git -C "$repo" rev-list --count "${base}..${head}")
echo "wrote ${out}: ${name} ${commits} commit(s), $(wc -c < "$out" | tr -d ' ') bytes"
