#!/usr/bin/env bash
# Resolve and ensure the locations SDD uses for its short-lived artifacts.
# Print an absolute path.
#
#   sdd-workspace                    → workspace directory for task briefs,
#                                      implementer reports, review packages and
#                                      review reports.
#   sdd-workspace --ledger PLAN_FILE → progress ledger for that plan.
#
# Set SDD_HOME to a repository path when a task spans repositories: artifacts
# and the ledger then live in that one repo — normally the one carrying the
# main change — while each repo is diffed on its own. Unset, both resolve from
# the current repo.
#
# The workspace lives in the working tree (not under .git/) because some harnesses
# protect .git/ from agent writes — which blocks an implementer worker from
# writing its report file there. A self-ignoring
# .gitignore keeps the workspace out of `git status` and out of accidental
# commits without modifying any tracked file.
#
# The ledger is written only by the controller, so that restriction does not
# apply to it, and it lives under the git directory instead — where `git clean
# -fdx` cannot reach it. Losing the ledger mid-execution is what makes a
# controller re-dispatch completed tasks. Its first line names the plan and the
# plan's revision; a ledger belonging to a different plan is rotated aside
# rather than appended to, so one worktree can run several plans over time
# without a stale entry being read as current progress.
#
# Single source of truth for both locations, so task-brief, review-package and
# the controller cannot drift.
#
# Usage: sdd-workspace [--ledger PLAN_FILE]
set -euo pipefail

mode=dir
plan=""
case "${1-}" in
  '') ;;
  --ledger)
    mode=ledger
    [ $# -eq 2 ] || { echo "usage: sdd-workspace --ledger PLAN_FILE" >&2; exit 2; }
    plan=$2
    [ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }
    ;;
  *) echo "usage: sdd-workspace [--ledger PLAN_FILE]" >&2; exit 2 ;;
esac

home=${SDD_HOME:-.}
root=$(git -C "$home" rev-parse --show-toplevel)
dir="$root/.superpowers/sdd"
mkdir -p "$dir"
printf '*\n' > "$dir/.gitignore"

if [ "$mode" = dir ]; then
  cd "$dir" && pwd
  exit 0
fi

legacy="$dir/progress.md"
gitdir=$(git -C "$home" rev-parse --absolute-git-dir)

if mkdir -p "$gitdir/superpowers" 2>/dev/null \
   && touch "$gitdir/superpowers/progress.md" 2>/dev/null; then
  ledger="$gitdir/superpowers/progress.md"
  # An execution that started before this location existed keeps its place.
  if [ -s "$legacy" ] && [ ! -s "$ledger" ]; then
    cat "$legacy" > "$ledger" && rm -f "$legacy"
  fi
else
  ledger="$legacy"
  touch "$ledger"
  echo "sdd-workspace: WARNING — cannot write under ${gitdir}; ledger falls back" >&2
  echo "  to ${ledger}, which \`git clean -fdx\` deletes. Losing it mid-run makes" >&2
  echo "  a controller re-dispatch completed tasks. Do not run git clean, or copy" >&2
  echo "  the ledger somewhere durable before you do." >&2
fi

# Plan identity: absolute path plus the revision that introduced the plan as it
# stands, so recovery knows which revision was executed.
planabs=$(cd "$(dirname "$plan")" && pwd)/$(basename "$plan")
planrev=$(git -C "$(dirname "$planabs")" log -1 --format=%h -- "$planabs" 2>/dev/null || true)
[ -n "$planrev" ] || planrev=uncommitted
header="plan: ${planabs} @ ${planrev}"

if [ ! -s "$ledger" ]; then
  printf '%s\n\n' "$header" > "$ledger"
else
  existing=$(head -1 "$ledger")
  case "$existing" in
    "plan: "*)
      # Rotate only a ledger that names a different plan. Same plan at a newer
      # revision keeps its entries: a plan is a live document and the header
      # records the revision the run started from.
      if [ "${existing%% @ *}" != "${header%% @ *}" ]; then
        # Never overwrite an existing archive: two rotations inside one second
        # would otherwise discard the first plan's recorded progress.
        stamp=$(date +%Y%m%d-%H%M%S)
        archive="${ledger%.md}-superseded-${stamp}.md"
        n=1
        while [ -e "$archive" ]; do
          archive="${ledger%.md}-superseded-${stamp}-${n}.md"
          n=$((n + 1))
        done
        mv "$ledger" "$archive"
        printf '%s\n\n' "$header" > "$ledger"
        echo "sdd-workspace: ledger named another plan; rotated to $archive" >&2
      fi
      ;;
    *)
      # Entries written before this script owned the header, including a ledger
      # just migrated from the pre-git-dir location. Adopt them; discarding a
      # run's recorded progress is the failure this file exists to prevent.
      printf '%s\n\n%s\n' "$header" "$(cat "$ledger")" > "$ledger.tmp" \
        && mv "$ledger.tmp" "$ledger"
      echo "sdd-workspace: adopted an existing headerless ledger for ${planabs}" >&2
      ;;
  esac
fi

printf '%s\n' "$ledger"
