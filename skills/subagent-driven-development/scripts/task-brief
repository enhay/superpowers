#!/usr/bin/env bash
# Extract one task's full text from an implementation plan into a file the
# implementer reads in one call, so the task text never has to be pasted
# through the controller's context.
#
# A task section ends at the next heading of the same or shallower level, so
# trailing sections (execution route, as-built notes) stay out of the last
# task's brief.
#
# Usage: task-brief PLAN_FILE TASKS [OUTFILE]
#   TASKS is "3", a range "2-4", or a list "2,4,5".
# Default OUTFILE: <repo-root>/.superpowers/sdd/task-<TASKS>-brief.md
# (per worktree; concurrent runs in the same working tree share it).
set -euo pipefail

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: task-brief PLAN_FILE TASKS [OUTFILE]" >&2
  exit 2
fi

plan=$1
n=$2
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

# TASKS is one task ("3"), a range ("2-4"), or a list ("2,4,5"). One task is the
# normal case; the range form covers a plan whose tasks were drawn too small to
# review alone and are dispatched together.
nums=""
IFS=',' read -ra parts <<< "$n"
for p in "${parts[@]}"; do
  case "$p" in
    *-*)
      lo=${p%%-*}; hi=${p##*-}
      case "$lo" in ''|*[!0-9]*) echo "bad task range: $p" >&2; exit 2;; esac
      case "$hi" in ''|*[!0-9]*) echo "bad task range: $p" >&2; exit 2;; esac
      [ "$lo" -le "$hi" ] || { echo "bad task range: $p" >&2; exit 2; }
      for ((i = lo; i <= hi; i++)); do nums="$nums $i"; done
      ;;
    *)
      case "$p" in ''|*[!0-9]*) echo "bad task number: $p" >&2; exit 2;; esac
      nums="$nums $p"
      ;;
  esac
done
alt=$(printf '%s' "$nums" | tr -s ' ' '\n' | sed '/^$/d' | paste -sd '|' -)

if [ $# -eq 3 ]; then
  out=$3
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace")
  out="$dir/task-${n//,/-}-brief.md"
fi

awk -v n="$alt" '
  /^```/ { infence = !infence }
  !infence && /^#+[ \t]/ {
    match($0, /^#+/); lvl = RLENGTH
    if ($0 ~ ("^#+[ \t]+Task[ \t]+(" n ")([^0-9]|$)")) {
      intask = 1; tasklvl = lvl
    } else if (intask && lvl <= tasklvl) {
      intask = 0
    }
  }
  intask { task[++t] = $0 }
  END {
    if (t == 0) exit 0
    for (i = 1; i <= t; i++) print task[i]
  }
' "$plan" > "$out"

if [ ! -s "$out" ]; then
  echo "task ${n} not found in ${plan} (no heading matching 'Task ${n}')" >&2
  exit 3
fi

echo "wrote ${out}: $(wc -l < "$out" | tr -d ' ') lines"
